rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isManager() {
      return hasRole('MANAGER');
    }

    function isStaff() {
      return isAdmin() || isManager();
    }

    // Colección: users
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Colección: products
    match /products/{productId} {
      allow read: if true; // Catálogo público
      allow create, update, delete: if isStaff(); // Solo Admin y Manager
    }

    // Colección: categories
    match /categories/{categoryId} {
      allow read: if true; // Categorías públicas
      allow create, update, delete: if isStaff(); // Solo Admin y Manager
    }

    // Colección: orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isStaff());
      allow create: if isAuthenticated();
      allow update: if isStaff(); // Modificar estado de envío
      allow delete: if isAdmin();
    }
  }
}
