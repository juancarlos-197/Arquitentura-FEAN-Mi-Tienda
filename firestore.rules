rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role;
    }

    function isStaff() {
      return hasRole('ADMIN') || hasRole('MANAGER') || (isSignedIn() && request.auth.token.email == 'jalban.dacompsc@gmail.com');
    }

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Colección: products
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Colección: categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Colección: orders
    match /orders/{orderId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isStaff();
      allow delete: if hasRole('ADMIN') || (isSignedIn() && request.auth.token.email == 'jalban.dacompsc@gmail.com');
    }

    // Colección: users
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow delete: if hasRole('ADMIN');
    }

    // Colección de conectividad / test
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
